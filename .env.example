# =====================================================================
#  Departamento Pessoal / REGISTROS XML-PDF — variáveis da API
#  Copie para ".env" (nunca versionar o .env) e preencha.
# =====================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=3333

# URL pública do front-end (usada em links de e-mail)
APP_PUBLIC_URL=http://localhost:5173

# Origens autorizadas (CORS restrito). Separe por vírgula.
CORS_ORIGINS=http://localhost:5173

# Atrás de proxy/Cloudflare/Tunnel: true para ler o IP real do cliente
TRUST_PROXY=false

# ---------------------------------------------------------------------
# Banco de dados
#   Produção:        postgres://usuario:senha@host:5432/gestao_xml
#   Desenvolvimento: pglite://./data/pglite   (PostgreSQL embutido, sem instalar nada)
# ---------------------------------------------------------------------
DATABASE_URL=pglite://./data/pglite
# DATABASE_SSL=true   # habilite em bancos gerenciados que exigem SSL

# ---------------------------------------------------------------------
# Autenticação
#   Gere segredos fortes:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------
JWT_ACCESS_SECRET=troque-este-segredo-com-no-minimo-32-caracteres
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Cookies: em produção use COOKIE_SECURE=true.
# Front e API em subdomínios do mesmo domínio → lax. Domínios diferentes → none.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Proteção contra força bruta
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Tentativas de login / solicitações de acesso por IP
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------
# Usuário Master inicial (criado pelo seed; a senha é gravada só como hash Argon2id)
# ---------------------------------------------------------------------
MASTER_NAME="Departamento pessoal"
MASTER_DEPARTMENT="Departamento Pessoal"
MASTER_INITIAL_PASSWORD="DP102030"

# ---------------------------------------------------------------------
# Agente Windows — o MESMO valor deve estar no .env do agente
# ---------------------------------------------------------------------
AGENT_API_TOKEN=troque-por-um-token-longo-e-aleatorio
# Sem heartbeat por este tempo → agente Offline
AGENT_OFFLINE_AFTER_SECONDS=60
# Execução sem atualização do agente por este tempo → Falha
AGENT_RUN_STALE_SECONDS=300

# ---------------------------------------------------------------------
# E-mail (SMTP)
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Destinatário das solicitações de acesso (nunca fixar no código)
DP_APPROVAL_EMAIL=

# ---------------------------------------------------------------------
# Logo oficial usada nos PDFs (o mesmo arquivo do front-end)
# ---------------------------------------------------------------------
LOGO_PATH=./apps/web/public/assets/logo-gestao-contadores.png

# Limite por arquivo XML recebido do agente (MB)
MAX_XML_FILE_MB=20

# Backup automático do banco embutido (pglite://). Vazio = desativado.
BACKUP_DIR=
BACKUP_KEEP=30
BACKUP_INTERVAL_HOURS=24
