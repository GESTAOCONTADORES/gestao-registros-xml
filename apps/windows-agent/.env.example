# =====================================================================
#  Gestão XML Agent — configuração (copie para .env na pasta do agente)
# =====================================================================

# Endereço da API (HTTPS obrigatório fora de localhost)
API_URL=https://api.seudominio.com.br

# Mesmo valor de AGENT_API_TOKEN configurado na API
AGENT_API_TOKEN=troque-por-um-token-longo-e-aleatorio

# Pasta raiz monitorada (unidade do Google Drive para computador)
ROOT_PATH=G:\Drives compartilhados\Departamento Pessoal\REGISTROS ROBO XML - PDF

# Nome da pasta de relatórios dentro da raiz
REPORTS_FOLDER_NAME=RELATORIOS ROBO

# Pasta local para cache incremental e logs (padrão: C:\ProgramData\GestaoXmlAgent)
# DATA_DIR=C:\ProgramData\GestaoXmlAgent

# Intervalos (ms)
POLL_INTERVAL_MS=3000
HEARTBEAT_INTERVAL_MS=15000

# Lotes enviados à API
BATCH_MAX_FILES=50
BATCH_MAX_MB=16
MAX_XML_FILE_MB=20

# Dias de retenção dos logs (rotação diária)
LOG_RETENTION_DAYS=30

# Somente para testes locais: permite http:// para um host que não seja localhost
# ALLOW_INSECURE_HTTP=false
